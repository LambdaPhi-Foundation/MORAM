# 09-factorial.mosm -- capstone: loops + memory + calls-free arithmetic
# Computes 5! = 120 with MEM[0]=counter, MEM[1]=accumulator.
# Run from E:/MORAM:
#   python -c "from moram import Moram; m=Moram(); m.run_text(open('examples/09-factorial.mosm').read()); print(m.output(), m.view())"
# Expected OUT: [120]  Deque: []

TINSERT 5
STORE 0
TINSERT 1
STORE 1
loop:
LOAD 0
JZ done
DROP_T
LOAD 1
LOAD 0
MUL
STORE 1          # acc *= counter
LOAD 0
TINSERT 1
SUB
STORE 0          # counter -= 1
JMP loop
done:
DROP_T
LOAD 1
OUT              # -> 120
HALT
